# Copy to deploy/config.env and fill in. Never commit the real file.
PROJECT=hiring-monitor
DOMAIN=hiring.example.com
EMAIL=you@example.com
REGION=us-east-1
INSTANCE_TYPE=t4g.small          # t4g.micro (1 GB) also works with WEB_WORKERS=1
# Restrict SSH to your own address. Find it with: curl -s https://checkip.amazonaws.com
SSH_CIDR=0.0.0.0/0
# AWS CLI profile to use.
AWS_PROFILE=default
# Your DNS zone, if it's hosted in Lightsail (02_stack.sh prints the record command).
DNS_ZONE=example.com
