# Copy to .env on the server (the EC2 bootstrap writes it for you). Not committed.
AB_DOMAIN=ab.example.com
ADMIN_EMAIL=admin@example.com
# Empty = no experiment: the monitor refreshes daily and logs nothing.
AB_EXPERIMENT=exp001_layout
AB_SALT=change-me-once-then-never-again
AB_SPLIT=50
# Stopping rule's time limit. Pre-registered run: 28. Set before traffic, never during.
AB_MAX_DAYS=28
COOKIE_SECURE=1
WEB_WORKERS=1
