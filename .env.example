# Copy to .env on the server. Not committed.
AB_DOMAIN=ab.example.com
ADMIN_EMAIL=admin@example.com
AB_EXPERIMENT=exp001_layout
AB_SALT=change-me-once-then-never-again
AB_SPLIT=50
COOKIE_SECURE=1
# Optional "Ask about this data" box. Leave the key empty to turn it off.
# Decide before traffic starts: the box is part of what both arms hold constant.
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-opus-5
CHAT_MAX_TOKENS=400
CHAT_DAILY_LIMIT=100
CHAT_PER_VISITOR_LIMIT=5
